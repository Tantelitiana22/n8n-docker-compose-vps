# ==============================================================================
# n8n Docker Compose Environment Configuration
# Automatically pre-configured with secure random keys.
# ==============================================================================

# n8n version
N8N_VERSION=latest

# Port & Network
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# Timezone
GENERIC_TIMEZONE=UTC
TZ=UTC

# Credentials encryption key (Keep this safe! Needed to decrypt credentials)
N8N_ENCRYPTION_KEY=5dd66361aeab0c0bf8127ae700584223c977b4f284e4789a

# PostgreSQL Database Configuration
POSTGRES_VERSION=16-alpine
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD=71ea200ae9814

# Non-root user for n8n to connect to PostgreSQL
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=odufqsn-example

# External Task Runner Token
RUNNERS_AUTH_TOKEN=run-token

# Sandbox Service API Key (shared between n8n and sandbox-api)
SANDBOX_API_KEY=108f5bb5f21d50606c1160053b535df04593edz12118ebd2b
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=995d06bnjlkjde314381ba7905de2c5a1edc1115dd1619c74
SANDBOX_API_RUNNER_API_KEY=cccb9c8a62cb6jdfqlkdj773691ff90d108f7b40fb7d3503

# Web search (SearXNG)
SEARXNG_SECRET=run-token

# AI Assistant Model Provider (OpenRouter)
N8N_INSTANCE_AI_MODEL=openrouter/openai/gpt-5.6-luna
N8N_INSTANCE_AI_MODEL_API_KEY=sk-or-v1-keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Instance Owner Credentials (Managed by Environment)
# Plaintext password: Admin123456!
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=mayemail@gmail.com
N8N_INSTANCE_OWNER_FIRST_NAME=firstname
N8N_INSTANCE_OWNER_LAST_NAME=lastname
N8N_INSTANCE_OWNER_PASSWORD_HASH=$$2a$$10$$T.scZxbPZI49OVILzrrqqO9rO9Q6SM/bd0xBTs/NRyIw.06A/N.OW

